# Copy to .env and fill in the account you use to log in to gbif.org. Wrap the password in
# single quotes if it contains spaces or characters like $ or #.
GBIF_USER=
GBIF_PWD=
GBIF_EMAIL=

# Credentials of the local RustFS server, any values work
S3_ACCESS_KEY=rustfsadmin
S3_SECRET_KEY=rustfsadmin
